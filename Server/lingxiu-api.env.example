# Store the real values only in /etc/lingxiu-api.env on the server.
# Never commit the real API key or proxy token.
ARK_API_KEY=<ARK_API_KEY>
ARK_MODEL_ID=doubao-seed-evolving
LINGXIU_PROXY_TOKEN=<RANDOM_PROXY_TOKEN>
LINGXIU_LISTEN_HOST=127.0.0.1
LINGXIU_LISTEN_PORT=8080
LINGXIU_MAX_BODY_BYTES=20971520
LINGXIU_RATE_LIMIT_PER_MINUTE=30

# Reserved for the account/data framework. Do not enable persistence until
# authentication, privacy terms and a backup destination are ready.
LINGXIU_DATA_RETENTION_ENABLED=false
DATABASE_URL=<POSTGRESQL_DATABASE_URL>
JWT_SECRET=<RANDOM_64_BYTE_SECRET>
OSS_ENDPOINT=<ALIYUN_OSS_ENDPOINT>
OSS_BUCKET=<ALIYUN_OSS_BUCKET>
