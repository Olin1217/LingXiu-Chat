[Unit]
Description=LingXiu temporary HTTPS tunnel
After=network-online.target lingxiu-api.service
Wants=network-online.target
Requires=lingxiu-api.service

[Service]
Type=simple
User=lingxiu-api
Group=lingxiu-api
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
