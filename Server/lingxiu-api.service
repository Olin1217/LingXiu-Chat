[Unit]
Description=LingXiu Ark Responses Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lingxiu-api
Group=lingxiu-api
WorkingDirectory=/opt/lingxiu-api
EnvironmentFile=/etc/lingxiu-api.env
ExecStart=/usr/bin/python3 /opt/lingxiu-api/lingxiu_proxy.py
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
